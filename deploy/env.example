# FTP-доступ к хостингу (скопируйте в deploy/.env или добавьте в automation/wp_autopost/.env)
# Beget: хост обычно ftp.ваш-домен.ru, логин/пароль — из панели Beget (раздел FTP)
FTP_HOST=ftp.kvadratyra.ru
FTP_USER=логин_ftp
FTP_PASSWORD=пароль_ftp
FTP_SECURE=false
# Корень сайта на сервере (Beget: обычно / или /public_html)
REMOTE_ROOT=/

# Опционально: базовый URL для HTTP-аудита
SITE_URL=https://kvadratyra.ru
